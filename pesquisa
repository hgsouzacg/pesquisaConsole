(async () => {
  const termo = "ppc";
  const resultados = [];
  
  // Função auxiliar para aguardar X milissegundos
  const sleep = (ms) => new Promise(resolve => setTimeout(resolve, ms));

  console.log("Iniciando a busca nas páginas 1 a 30...");

  for (let page = 1; page <= 30; page++) {
    const url = `https://suap.ifrn.edu.br/demandas/atualizacoes/?page=${page}`;
    try {
      const res = await fetch(url);
      const text = await res.text();

      if (text.toLowerCase().includes(termo.toLowerCase())) {
        console.log(`%c[✓] Encontrado na página ${page}! Abrindo em nova aba...`, "color: green; font-weight: bold;");
        resultados.push({ pagina: page, url: url });
        
        // Abre a aba
        window.open(url, '_blank');
        
        // Espera 1.5 segundo antes de continuar o loop para evitar o bloqueio
        await sleep(1500);
      } else {
        console.log(`[-] Página ${page}: Não encontrado.`);
      }
    } catch (err) {
      console.error(`[!] Erro na página ${page}:`, err);
    }
  }

  console.log("\n=== RESULTADO FINAL ===");
  console.table(resultados);
})();
